{
  "name": "concept-atlas",
  "version": "3.0.0",
  "description": "基于 MDX 的概念缩放式知识讲解模板",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate-content.mjs",
    "audit:css": "node scripts/css-usage-audit.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test \"test/**/*.test.mjs\"",
    "sync": "node scripts/sync-template.mjs",
    "check:sync": "node scripts/sync-template.mjs --check",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"scripts/**/*.mjs\" \"test/**/*.mjs\" \"packages/concept-atlas-dense-explain/bin/**/*.mjs\" \"*.js\" && npm run sync",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" \"scripts/**/*.mjs\" \"test/**/*.mjs\" \"packages/concept-atlas-dense-explain/bin/**/*.mjs\" \"*.js\"",
    "build": "npm run validate && node scripts/build.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mdx-js/rollup": "^3.0.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.475.0",
    "mermaid": "^11.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@eslint/js": "^9.39.5",
    "@mdx-js/mdx": "^3.1.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "vite": "^5.4.14",
    "vite-plugin-singlefile": "^2.1.0"
  },
  "author": "wurenrumian",
  "license": "MIT"
}
